# Copy this file to .env and fill in your real values
# Never commit .env to git
#
# This is the REPO-ROOT .env (config.py walks up from backend/ to find it — there
# is no backend/.env). For local dev, point SUPABASE_* AND DATABASE_URL at the
# `savehere-dev` project (NOT prod). Local dev runs on the dev Postgres pooler
# (SQLite retired 2026-07-21, for Codespaces persistence).
# Full per-environment matrix: docs/ENVIRONMENTS.md

# Anthropic (Claude Haiku - summarization + tagging)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI (Whisper - transcription) — leave blank if using local Whisper
OPENAI_API_KEY=your_openai_api_key_here

# Apify (Instagram scraper) — leave blank. Nothing in the code reads this today;
# the page-scrape path made it unnecessary (see TODO.md "Apify LinkedIn integration").
APIFY_API_KEY=

# Outbound proxy for extraction traffic (yt-dlp + httpx page/caption fetches).
# LEAVE BLANK. Blank is a true no-op: no proxy argument is passed anywhere and
# behaviour is identical to not having this setting at all. It costs nothing.
# 💸 Only fill this in with a paid residential/mobile proxy, and only after adding
# the per-user proxy spend cap — it is bandwidth-priced (~$2-8/GB) with NO ceiling
# in code, unlike Claude which has a console-level cap. Never use a free public
# proxy list: slower than being blocked, and they can read the traffic.
EXTRACTOR_PROXY_URL=

# Supabase (dashboard → Settings → API Keys). New key system:
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "Publishable" key (sb_publishable_...) — safe to share:
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Public JWKS endpoint to verify ECC-signed access tokens (defaults to this path under URL):
SUPABASE_JWKS_URL=https://YOUR-PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# Backend-only — NEVER ship to the mobile app. A "Secret" key (sb_secret_...):
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_key_here

# App
ENV=development

# ── Tier system (app/entitlements.py) ──────────────────────────────────────
# Per-user AI actions allowed per UTC day (ask + recipe + workout + (re)summarize
# all count). This is the IN-TRIAL limit; lower it to tighten the budget.
AI_DAILY_LIMIT=10
# Post-trial free tier: small daily AI trickle (keeps the app alive to convert).
AI_FREE_DAILY_LIMIT=3
# Paid-tier daily limit — applies to users whose JWT has app_metadata.tier == "pro"
# (stamped via scripts/set_tier.py now, RevenueCat webhook at launch).
AI_PRO_DAILY_LIMIT=20
# Trial length (days from first authenticated request; server-side clock).
TRIAL_DAYS=10
# Post-trial free tier: max TOTAL saves. NOTHING IS EVER DELETED — saves past the
# cap become read-only (see app/library_lock.py) and unlock again by deleting
# newer ones or upgrading.
FREE_SAVE_LIMIT=50

# ── Billing (RevenueCat → app_metadata.tier) ───────────────────────────────
# Both are REQUIRED before anyone can buy Pro, and both are fail-closed while
# unset: the webhook 401s every call and POST /api/billing/sync returns 503.
# Shared secret you also set in RevenueCat → Integrations → Webhooks as the
# "Authorization header value".
REVENUECAT_WEBHOOK_TOKEN=
# RevenueCat v1 REST **secret** key (Dashboard → API keys → secret). Used by
# /api/billing/sync to confirm a purchase server-to-server so a user who has just
# paid does not wait on the webhook. ⚠️ NOT the public key the app ships.
REVENUECAT_API_KEY=
# The entitlement identifier in RevenueCat that means Pro. A typo here entitles
# nobody, silently.
REVENUECAT_PRO_ENTITLEMENT=pro

# Production only — comma-separated web origins allowed by CORS (defaults to *).
# Set to the deployed web app's domain once it's known, e.g. https://savehere.app
ALLOWED_ORIGINS=*

# Database. Local dev + staging + prod all use Postgres now (SQLite retired for
# local dev 2026-07-21 so data persists across Codespaces). Local dev → set this
# to the savehere-dev pooler; prod → the SaveHere pooler (set in Render, not here).
# ⚠️ Use the SESSION POOLER string (Supabase dashboard → Connect → Session pooler,
# port 5432): the direct string is IPv6-only (fails from Render) and the
# transaction pooler (6543) breaks SQLAlchemy prepared statements. URL-encode any
# @ : / # ? in the password, or let Supabase generate a URL-safe one.
# (Leaving this unset still falls back to local SQLite ./savehere.db.)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
