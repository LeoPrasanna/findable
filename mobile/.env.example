# Copy this file to mobile/.env and fill in your real values.
# Only EXPO_PUBLIC_* vars are exposed to the app bundle — never put a secret
# (service_role key, JWT secret) here; those are backend-only.
#
# This drives LOCAL `expo start`. Point it at the `savehere-dev` Supabase project
# so local sign-ups land in dev, not prod. EAS builds get their per-env values
# from eas.json build profiles instead. See docs/ENVIRONMENTS.md for the matrix.

# Backend API base URL. Defaults to http://localhost:8000 if unset.
# In a Codespace, set this to the forwarded backend URL (see docs/REMOTE_DEV.md).
EXPO_PUBLIC_API_URL=http://localhost:8000

# Supabase (auth). Project URL + the "Publishable" key (sb_publishable_...) — safe
# to ship in the app. Dashboard → Settings → API Keys. NEVER put a secret key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your_key_here

# Crash reporting. NOT a secret — a DSN is compiled into every copy of the app
# and can only WRITE events; it cannot read anything. Safe in git, unlike the
# Supabase service role key or the Apple .p8.
# Leave unset locally: Sentry stays off (see the guard in app/_layout.tsx), which
# is what you want while developing. It is set in EAS for every environment.
EXPO_PUBLIC_SENTRY_DSN=

# ── RevenueCat (in-app purchases) ─────────────────────────────────────────────
# NOT secrets. RevenueCat's platform keys are designed to ship inside the app
# binary; the key that must never appear here is the v1 REST SECRET, which is
# backend-only (REVENUECAT_API_KEY in the root .env.example).
# Leave unset locally: billing reports itself unavailable and the paywall renders
# read-only, which is the correct behaviour on web too.
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=

# RevenueCat Test Store key — purchases without any App Store / Play setup.
# ⚠️ ONLY EVER USED IN A DEVELOPMENT BUILD. The SDK does not degrade when it finds
# a test key in a release build: it logs, alerts, then CRASHES on purpose, and it
# decides by how the app was COMPILED, not how it was distributed — so TestFlight
# and every Play testing track crash too. `services/billingPlans.ts` gates this
# behind `__DEV__` precisely so a mis-set EAS environment variable cannot ship a
# binary that dies on launch.
EXPO_PUBLIC_RC_TEST_KEY=
